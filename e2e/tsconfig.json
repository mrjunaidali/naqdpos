{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Node runs the support scripts directly (type stripping): erasable TypeScript only.
    "erasableSyntaxOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["*.ts", "support", "tests"]
}
