# Every setting (docs/deployment.md §2). Copy to .env at the repo root; never commit real values.
# Local: `pnpm db:create` fills DATABASE_URL, TEST_DATABASE_URL and the local API defaults.
# Production refuses to start while a required setting is missing and names each one.

# --- Front ends (pos, admin; build time; the only values the browser sees) ---
VITE_API_URL=http://localhost:8787
# Admin only: the shop app address put in the owner's WhatsApp invite text (US012)
VITE_POS_URL=http://localhost:5173

# --- Static sites (Caddy, run time; deploy/Caddyfile) ---
# Content-Security-Policy: the API and the storage download/upload origins
# API_ORIGIN=https://api.naqd.pk
# FILES_ORIGIN=https://<account-id>.r2.cloudflarestorage.com

# --- API and worker ---
# NODE_ENV defaults to production; `pnpm --filter @naqdpos/api dev` sets development.
# App role naqdpos_app (RLS applies): postgres://naqdpos_app:<password>@<host>:5432/<db>
DATABASE_URL=
# Owner role: migrations (pnpm db:deploy), the worker's pg-boss schema and backups only.
# Railway private network (*.railway.internal) has no TLS: add ?sslmode=disable there.
DATABASE_ADMIN_URL=

# Files bucket (shop logos; bill photos later). All five or none: none = file features off.
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Long random secret (at least 32 characters) and the public API URL (https in production)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google sign-in is off while these are empty
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API: the request header in which the host's edge proxy puts the client IP (Railway: x-real-ip).
# Used for the sign-in rate limits (per client IP) and, masked, in the request log. Name only a
# header the edge OVERWRITES (deployment §2, spoof test). Empty = no client IP: all clients share
# one rate-limit bucket per path (fine on a dev PC).
CLIENT_IP_HEADER=
# API, temporary: true logs the full client IP instead of 203.0.113.x / 2001:db8:85a3:x:x:x:x:x,
# for the spoof test only. Default false; turn it off again afterwards.
LOG_FULL_CLIENT_IP=

# Email (sign-in codes, PIN reset codes, owner invites). Production needs MAIL_FROM plus either
# RESEND_API_KEY (Resend's HTTPS API; use it on Railway Hobby, which blocks SMTP ports) or all four
# SMTP_* (any SMTP server). RESEND_API_KEY wins when both are set. Every send times out after 10 s.
# Empty in development = codes are printed by the API instead.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Allowed front-end origins for CORS, comma separated (https in production)
APP_ORIGINS=
# The shop app's address, used in the owner invite email (required in production)
POS_URL=

# Optional. Raise only for a breaking sync change: apps older than this get 426 on /sync/*
# and keep selling offline until reloaded (architecture §4). Empty = accept every version.
MIN_APP_VERSION=

# --- Worker only: nightly backups (US008) ---
# Its own bucket and its own token, scoped to that bucket only.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# 32 random bytes, base64: `openssl rand -base64 32`. Keep a copy in the password manager:
# without it no backup can be restored.
BACKUP_ENCRYPTION_KEY=

# --- Local only ---
# naqdpos_test, used by `pnpm db:test`
TEST_DATABASE_URL=
# Folder of pg_dump / pg_restore (18 or newer) when not on PATH, e.g.
# C:\Program Files\PostgreSQL\18\bin (backup tests and pnpm backup:restore)
PG_BIN_DIR=
# Caddy binary for `pnpm e2e` when not on PATH
CADDY_BIN=
# Optional: API port (default 8787; hosts usually set it), log level (default info).
PORT=
LOG_LEVEL=
