{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": ["apps/api/**", "packages/core/**", "db/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "node src/worker.ts",
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS"
  }
}
