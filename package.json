{
  "name": "naqdpos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:lan": "node scripts/dev-lan.ts",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:create": "node db/scripts/db.ts create",
    "db:up": "node db/scripts/db.ts up",
    "db:new": "node db/scripts/db.ts new",
    "db:reset": "node db/scripts/db.ts reset",
    "db:test": "node db/scripts/db.ts test",
    "check:precache": "pnpm --filter @naqdpos/pos build && node scripts/check-precache.ts",
    "i18n:export-review": "node scripts/urdu-review.ts export",
    "i18n:import-review": "node scripts/urdu-review.ts import",
    "admin:grant": "node db/scripts/admin.ts grant",
    "admin:revoke": "node db/scripts/admin.ts revoke"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
